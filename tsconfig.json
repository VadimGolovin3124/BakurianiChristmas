{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite/client",
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@worker/*": [
        "./worker/*"
      ]
    }
  },
  "include": [
    "app",
    "lib",
    "hooks",
    "main.tsx",
    "worker",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}